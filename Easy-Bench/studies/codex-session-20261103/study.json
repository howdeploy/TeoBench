      "model": "Codex / GPT-6 (exact deployment ID unavailable)",
      "effort": "default",
      "replicate": 0,
      "answer": "WITH ranked AS (\n    SELECT entity, value,\n           ROW_NUMBER() OVER (PARTITION BY entity ORDER BY stamp DESC, id DESC) AS rn\n    FROM events\n)\nSELECT entity, value FROM ranked WHERE rn = 1 ORDER BY entity;\n",
