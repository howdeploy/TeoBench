      }
    },
    {
      "task_id": "S04",
      "model": "Codex / GPT-6 (exact deployment ID unavailable)",
      "effort": "default",
      "replicate": 0,
      "answer": "WITH days AS (\n    SELECT DISTINCT user_id, day FROM visits\n), numbered AS (\n    SELECT user_id, day - ROW_NUMBER() OVER (PARTITION BY user_id ORDER BY day) AS island\n    FROM days\n), streaks AS (\n    SELECT user_id, COUNT(*) AS length FROM numbered GROUP BY user_id, island\n)\nSELECT user_id, MAX(length) FROM streaks GROUP BY user_id ORDER BY user_id;\n",
      "tool_history": [],
      "elapsed_seconds": null,
      "transport_error": null,
      "evaluation": {
        "semantic_pass": true,
        "strict_pass": true,
        "passed_cases": 12,
